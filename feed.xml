---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/" rel="alternate" type="text/html"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}/feed.xml</id>
  <title type="html">{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <author>
    <name>{{ site.author.name | default: "RUPESH" }}</name>
  </author>

  {% for post in site.posts %}
  <entry xml:lang="{{ post.lang | default: 'en' }}">
    <title type="html">{{ post.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ post.url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}"/>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <id>{{ site.url }}{{ post.url }}</id>
    <summary type="html"><![CDATA[ {{ post.excerpt | xml_escape }} ]]></summary>
  </entry>
  {% endfor %}

  {% for page in site.pages %}
    {% unless page.url == '/feed.xml' or page.url == '/sitemap.xml' or page.url == '/404.html' or page.url == '/robots.txt' %}
    {% if page.title %}
  <entry xml:lang="{{ page.lang | default: 'en' }}">
    <title type="html">{{ page.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ page.url }}" rel="alternate" type="text/html" title="{{ page.title | xml_escape }}"/>
    <published>{{ page.date | default: site.time | date_to_xmlschema }}</published>
    <updated>{{ page.last_modified_at | default: site.time | date_to_xmlschema }}</updated>
    <id>{{ site.url }}{{ page.url }}</id>
    <summary type="html"><![CDATA[ {{ page.excerpt | xml_escape }} ]]></summary>
  </entry>
    {% endif %}
    {% endunless %}
  {% endfor %}

</feed>
